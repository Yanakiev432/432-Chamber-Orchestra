---
const title = "432 Chamber Orchestra · Redirecting to Bulgarian";
const previewMode = import.meta.env.PUBLIC_PREVIEW_MODE === "true";
const canonicalHome = new URL("/bg/",Astro.site ?? new URL("https://432hz-orchestra.com/")).href;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content={previewMode ? "noindex,nofollow" : "noindex,follow"} />
    <link rel="canonical" href={canonicalHome} />
    <meta http-equiv="refresh" content="0; url=/bg/" />
    <script is:inline>
      window.location.replace("/bg/");
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; margin: 2rem; background: var(--color-brand-bg, #f8fafc); color: var(--color-brand-text, #1f2937);">
    <main>
      <h1>432 Chamber Orchestra</h1>
      <p>Българската версия е основната начална страница.</p>
      <p><a href="/bg/">Продължете към /bg/</a></p>
    </main>
  </body>
</html>
