---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CampaignLanding from "../../../components/CampaignLanding.astro";
import { campaignLandingContent, siteContent } from "../../../content/siteContent";

const campaign = campaignLandingContent.en;
const content = {
  ...siteContent.en,
  meta: campaign.meta
};
---

<BaseLayout content={content} lang="en" canonicalHref={campaign.canonicalHref} alternateHref={campaign.alternateHref}>
  <CampaignLanding campaign={campaign} lang="en" />
</BaseLayout>
