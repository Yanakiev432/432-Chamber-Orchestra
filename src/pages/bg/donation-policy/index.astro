---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SimplePolicyPage from "../../../components/SimplePolicyPage.astro";
import { siteContent } from "../../../content/siteContent";

const sections = [
  { title: "Кой получава подкрепата", body: ["Подкрепата се получава от Фондация 432 Херца, ЕИК 204925949."] },
  { title: "Банков превод", body: ["Банковият превод в момента е официалният начин за плащане. Потвърдената валута е EUR."] },
  { title: "Сертификат за дарение", body: ["Фондацията може да издава сертификати за дарение след проверка. Това не е автоматичен данъчен документ и тази страница не прави твърдение за данъчно облекчение."], list: ["Заявка за сертификат: /bg/donation-certificate/"] },
  { title: "Проектно насочена подкрепа", body: ["Когато е възможно, подкрепата трябва да води до определен артистичен резултат с обхват, цел и път за отчетност."] },
  { title: "Обещание за отчетност", body: ["За подкрепени проектни фази фондацията се стреми да предоставя документация, архивна или проектна страница, когато е приложимо, и кратък отчет след проекта."] },
  { title: "Какво не се обещава", body: ["Тук не се обещават автоматични документи, данъчно облекчение, картови плащания, правно обвързващ срок за отчетност, потвърдена дата, място, състав, приходи от билети, оферти от доставчици или финална програма."] },
  { title: "Контакт", body: ["Свържете се с Фондация 432 Херца на info@432hz-foundation.com."] }
];
---

<BaseLayout content={{ ...siteContent.bg, meta: { title: "Политика за дарения и отчетност · 432 Chamber Orchestra", description: "Как Фондация 432 Херца обработва подкрепа, банкови преводи, сертификати и отчетност." } }} lang="bg" canonicalHref="/bg/donation-policy/" alternateHref="/en/donation-policy/">
  <SimplePolicyPage lang="bg" title="Политика за дарения и отчетност" intro={["Тази страница обяснява как Фондация 432 Херца обработва подкрепата."]} sections={sections} />
</BaseLayout>
