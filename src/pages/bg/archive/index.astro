---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PhotoArchiveSection from "../../../components/PhotoArchiveSection.astro";
import LegacyArchiveDirectory from "../../../components/LegacyArchiveDirectory.astro";
import { siteContent } from "../../../content/siteContent";

const content = {
  ...siteContent.bg,
  meta: {
    title: "Фотоархив · 432 Chamber Orchestra",
    description:
      "Фотоархив на 432 Chamber Orchestra: диригент, квартет и концерт на оркестъра."
  }
};
---

<BaseLayout content={content} lang="bg" canonicalHref="/bg/archive/" alternateHref="/en/archive/">
  <PhotoArchiveSection lang="bg" />
  <LegacyArchiveDirectory lang="bg" />
</BaseLayout>
