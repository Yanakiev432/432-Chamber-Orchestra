---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CampaignLanding from "../../../components/CampaignLanding.astro";
import { campaignLandingContent, siteContent } from "../../../content/siteContent";

const campaign = campaignLandingContent.bg;
const content = {
  ...siteContent.bg,
  meta: campaign.meta
};
---

<BaseLayout content={content} lang="bg" canonicalHref={campaign.canonicalHref} alternateHref={campaign.alternateHref}>
  <CampaignLanding campaign={campaign} lang="bg" />
</BaseLayout>
