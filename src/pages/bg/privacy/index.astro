---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SimplePolicyPage from "../../../components/SimplePolicyPage.astro";
import { siteContent } from "../../../content/siteContent";

const sections = [
  { title: "Администратор на данни", body: ["Администратор на данните е Фондация 432 Херца, ЕИК 204925949. Контакт: info@432hz-foundation.com."] },
  { title: "Какви данни се събират", body: ["Сайтът може да събира информация, която доброволно предоставяте: име, имейл, предпочитан език, интерес към подкрепа, съобщение и данни за заявка за сертификат за дарение."] },
  { title: "Защо се събират данни", body: ["Информацията се използва за Слушателския кръг, концерти, записи, архивни новини, кампании, комуникация с подкрепящи и заявки за сертификат за дарение."] },
  { title: "Съгласие и отписване", body: ["Можете да се отпишете или да поискате прекратяване на комуникацията по всяко време, като пишете на info@432hz-foundation.com."] },
  { title: "Инструменти и обработващи", body: ["CRM/form интеграциите са подготвени, но не са активни. Когато бъдат свързани, сайтът може да използва инструменти за форми и CRM като Brevo, Tally или Google Sheets за обработка на информация за подкрепящите."] },
  { title: "Съхранение", body: ["Информацията се пази само доколкото е необходима за комуникация, администриране на подкрепата, документация или правен/счетоводен контекст. Тук не се заявява фиксиран срок за съхранение."] },
  { title: "Права и контакт", body: ["Можете да се свържете с фондацията относно достъп, корекция, изтриване или ограничаване на лични данни на info@432hz-foundation.com."] },
  { title: "Актуализации", body: ["Тази страница може да бъде обновявана при активиране на форми/CRM интеграции или промени в support flow на сайта."] }
];
---

<BaseLayout content={{ ...siteContent.bg, meta: { title: "Поверителност · 432 Chamber Orchestra", description: "Информация за поверителност и GDPR за 432 Chamber Orchestra и Фондация 432 Херца." } }} lang="bg" canonicalHref="/bg/privacy/" alternateHref="/en/privacy/">
  <SimplePolicyPage lang="bg" title="Поверителност / GDPR" intro={["Тази страница обяснява как Фондация 432 Херца обработва информация за подкрепящи, подадена чрез сайта."]} sections={sections} />
</BaseLayout>
