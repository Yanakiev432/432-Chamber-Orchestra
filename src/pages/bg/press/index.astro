---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PressPage from "../../../components/PressPage.astro";
import { siteContent } from "../../../content/siteContent";

const content = {
  ...siteContent.bg,
  meta: {
    title: "Преса / Медии · 432 Chamber Orchestra",
    description:
      "Материали за медии относно 432 Chamber Orchestra и Фондация 432 Херца: основни факти, спонсорско резюме, архиви, лога и избрани снимки."
  }
};
---

<BaseLayout content={content} lang="bg" canonicalHref="/bg/press/" alternateHref="/en/press/">
  <PressPage lang="bg" />
</BaseLayout>
