---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegacyWordPressPhotoGallery from "../components/LegacyWordPressPhotoGallery.astro";
import LegacyWordPressVideoGallery from "../components/LegacyWordPressVideoGallery.astro";
import LegacyMusicCatalogue from "../components/LegacyMusicCatalogue.astro";
import LegacyAudioEmbeds from "../components/LegacyAudioEmbeds.astro";
import LegacyExtendedArchiveListing from "../components/LegacyExtendedArchiveListing.astro";
import LegacyPublicListeningExamples from "../components/LegacyPublicListeningExamples.astro";
import { siteContent } from "../content/siteContent";
import legacy from "../content/legacyArchive.json";
import gmedia from "../content/legacyGmediaRoutes.json";
import taxonomy from "../content/legacyTaxonomyRoutes.json";
import extended from "../content/legacyExtendedRoutes.json";
import featured from "../content/legacyFeaturedAttachments.json";
import demoAttachments from "../content/publicDemoAttachmentRoutes.json";

export function getStaticPaths() {
  return [...legacy.items, ...gmedia.items, ...taxonomy.items, ...extended.items, ...featured.items, ...demoAttachments.items].map((record) => ({
    params: { legacy: record.path.replace(/^\/|\/$/g, "") },
    props: { record }
  }));
}
const { record } = Astro.props as { record: (typeof legacy.items)[number] | (typeof gmedia.items)[number] | (typeof taxonomy.items)[number] | (typeof extended.items)[number] | (typeof featured.items)[number] | (typeof demoAttachments.items)[number] };
const lang = record.language === "bg" ? "bg" as const : "en" as const;
const bg = lang === "bg";
const kind = bg
  ? ({ page: "Историческа страница", post: "Публикация", product: "Архивен запис", taxonomy: "Категория", event: "Концерт", event_category: "Концертна категория", event_view: "Концертен календар", gmedia_photo:"Архивна фотография", gmedia_index:"Фотоархив", gmedia_album:"Фотоалбум", gmedia_album_index:"Албуми", gmedia_gallery:"Галерия", archive_collection:"Колекция",audio_attachment:"Звукозапис",image_attachment:"Изображение",demo_attachment:"Архивен звуков откъс" } as const)[record.kind]
  : ({ page: "Historical page", post: "Publication", product: "Archive recording", taxonomy: "Category", event: "Concert", event_category: "Concert category", event_view: "Concert calendar", gmedia_photo:"Historic photograph", gmedia_index:"Photo archive", gmedia_album:"Photo album", gmedia_album_index:"Albums", gmedia_gallery:"Gallery", archive_collection:"Collection",audio_attachment:"Audio recording",image_attachment:"Image",demo_attachment:"Historic audio excerpt" } as const)[record.kind];
const copy = {
  ...siteContent[lang],
  meta: {
    title: record.title + " · 432 Chamber Orchestra",
    description: (record.paragraphs[0] || record.title).slice(0, 155)
  }
};
const itemById = new Map(legacy.items.filter((r) => r.kind === "post" || r.kind === "product" || r.kind === "event").map((r) => [r.id, r]));
const related = record.relatedIds.map((id) => itemById.get(id)).filter((r): r is NonNullable<typeof r> => Boolean(r) && r?.language === lang);
const gallery = (record.kind === "page" && /\/(?:gallery|галерия)\/$/i.test(record.path)) ||
  ["gmedia_index","gmedia_album","gmedia_album_index","gmedia_gallery"].includes(record.kind);
const concertPhotoPost = record.kind === "post" && /(?:photos-concert|снимки-концерт)/i.test(record.path);
const musicIndex = record.kind === "page" && /(?:buy-our-music|купете-нашата-музика|магазин|shop)\/$/i.test(record.path);
const video = record.kind === "page" && /(?:video|видео)/i.test(record.path);
const contentLinks = record.sourceLinks.filter((u) => {
  try {
    return !(/432hz-orchestra\.com\/wp-content\//i.test(u));
  } catch { return false; }
});
const displayed = record.paragraphs.filter((p) => p.trim().length);
const published = record.date && /^\d{4}-\d\d-\d\d/.test(record.date) ? record.date.slice(0, 10) : null;
const photoAlbumPath = "albumPath" in record ? record.albumPath : null;
const galleryAlbumId = "albumId" in record ? (record.albumId || undefined) : undefined;
const listingLinks = "listingLinks" in record ? record.listingLinks : [];
const paginationLinks = "paginationLinks" in record ? record.paginationLinks : [];
const archivePage = "archivePage" in record ? record.archivePage : 1;
const legacyAudioSample = record.kind === "audio_attachment" ? record : null;
const demoAttachment = record.kind === "demo_attachment" && "demoNumber" in record ? record : null;
const parentMediaPath = "parentPath" in record ? record.parentPath : null;
const showPitchComparison = record.path === "/en/about/432-hz-concert-pitch/";
const pitchComparisonSamples = featured.items.filter((item) => item.kind === "audio_attachment" && item.mediaMime === "audio/mpeg");
const historicConcertPoster = record.kind === "event" && record.id === 316;
---
<BaseLayout content={copy} lang={lang} canonicalHref={record.path} alternateHref={record.alternatePath}>
  <section class="border-b border-brand-border bg-[#122B22] py-12 md:py-20">
    <div class="container max-w-5xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#C7A76D]">{kind}</p>
      <h1 class="max-w-4xl font-serif text-3xl leading-tight text-[#F0E8D9] sm:text-5xl">{record.title}</h1>
      {published && <p class="mt-5 text-sm text-[#D7CEBF]">{bg ? "Публикувано" : "Published"}: <time datetime={published}>{published}</time></p>}
      {record.eventDate && <p class="mt-3 text-sm text-[#D7CEBF]">{bg ? "Дата на концерта" : "Concert date"}: <time datetime={record.eventDate}>{record.eventDate}</time></p>}
    </div>
  </section>

  <section class="bg-[#091F19] py-12 md:py-20">
    <div class="container max-w-5xl">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.4fr)_minmax(230px,0.6fr)]">
        <article class="min-w-0 space-y-6">
          {record.thumbnail && <img class="max-h-[500px] w-full object-contain" src={record.thumbnail} alt={record.title} loading="lazy" />}
          {record.inlineImages.map((image) => <img class="max-h-[500px] w-full object-contain" src={image} alt={record.title} loading="lazy" />)}
          {record.dynamicWordPress ? (
            <div class="border-l-2 border-[#C7A76D] pl-6 text-base leading-8 text-[#D7CEBF]">
              {bg
                ? "Записите и изданията на оркестъра могат да бъдат разгледани в раздел „Музика“. За поръчки, направени през предишния сайт, използвайте първоначалната страница."
                : "Explore the orchestra’s recordings and releases in the Music section. For earlier orders, please use the original site."}
            </div>
          ) : (
            <>
              {displayed.map((paragraph) => <p class="whitespace-pre-line break-words text-base leading-8 text-[#D7CEBF]">{paragraph}</p>)}
              {displayed.length === 0 && !video && !demoAttachment && <p class="text-base leading-8 text-[#D7CEBF]">{bg
                ? "Разгледайте свързаните публикации, фотографии и записи от историята на оркестъра."
                : "Explore related articles, photographs and recordings from the orchestra’s history."}</p>}
            </>
          )}
          {record.kind === "archive_collection" && <LegacyExtendedArchiveListing lang={lang} items={listingLinks} pages={paginationLinks} currentPage={archivePage} />}
          {showPitchComparison && <LegacyPublicListeningExamples lang={lang} items={pitchComparisonSamples} />}
          {legacyAudioSample && <LegacyPublicListeningExamples lang={lang} items={[legacyAudioSample]} heading={false} />}
          {demoAttachment && (
            <section class="border border-[#C7A76D]/30 bg-[#122B22] p-5 md:p-7" aria-label={bg ? "Прослушване на откъса" : "Listen to the excerpt"}>
              <p class="mb-4 text-sm text-[#D7CEBF]">
                {bg ? "Одобрен кратък промоционален откъс от историческия каталог на квартета." : "A verified short promotional excerpt from the quartet's historical catalogue."}
              </p>
              <audio class="w-full" controls preload="none">
                <source src={demoAttachment.mediaSrc} type="audio/mpeg" />
                {bg ? "Браузърът не поддържа възпроизвеждането." : "This browser cannot play the recording."}
              </audio>
              <a class="mt-5 inline-flex border-b border-[#C7A76D] py-2 text-[#F0E8D9] hover:text-[#C7A76D]" href={demoAttachment.excerptPath}>
                {bg ? "Към откъса в дискографията" : "View the excerpt in the recordings catalogue"}
              </a>
            </section>
          )}
          {historicConcertPoster && <a class="inline-flex border-b border-[#C7A76D] py-2 text-[#F0E8D9] hover:text-[#C7A76D]" href="/bg/event/концерт-на-квартет-от-камерен-оркестъ/афиш-чайната-fw-2/">Афиш на концерта</a>}
          {parentMediaPath && <a class="inline-flex border-b border-[#C7A76D] py-2 text-[#F0E8D9] hover:text-[#C7A76D]" href={parentMediaPath}>{bg ? "Към концерта" : "Related page"}</a>}
          {record.audioEmbeds.length > 0 && <LegacyAudioEmbeds lang={lang} items={record.audioEmbeds} />}
          {record.bandcampUrl && (
            <a class="inline-flex border border-[#C7A76D] bg-[#C7A76D] px-6 py-3 font-semibold text-[#091F19] transition hover:bg-[#F0E8D9]" href={record.bandcampUrl} target="_blank" rel="noopener noreferrer">
              {bg ? "Слушайте и купете в Bandcamp" : "Listen and buy on Bandcamp"}
            </a>
          )}
          {record.kind === "gmedia_photo" && photoAlbumPath && (
            <a class="inline-flex border-b border-[#C7A76D] py-2 text-[#F0E8D9] hover:text-[#C7A76D]" href={photoAlbumPath}>{bg ? "Към оригиналния фотоалбум" : "View original photo album"}</a>
          )}
          {record.kind === "gmedia_album_index" && (
            <div class="border-t border-[#C7A76D]/30 pt-6">
              <h2 class="mb-4 font-serif text-2xl text-[#F0E8D9]">{bg ? "Концертни албуми" : "Concert albums"}</h2>
              <ul class="grid gap-3">{gmedia.items.filter((entry) => entry.kind === "gmedia_album").map((entry) => (
                <li><a class="underline decoration-[#C7A76D]/70 underline-offset-4" href={entry.path}>{entry.title}</a></li>
              ))}</ul>
            </div>
          )}
          {related.length > 0 && (
            <div class="border-t border-[#C7A76D]/30 pt-8">
              <h2 class="mb-5 font-serif text-2xl text-[#F0E8D9]">{bg ? "Още от архива" : "More from the archive"}</h2>
              <ul class="grid gap-3">
                {related.map((item) => <li class="flex flex-wrap items-baseline gap-3">{item.eventDate && <time class="text-sm text-[#C7A76D]" datetime={item.eventDate}>{item.eventDate}</time>}<a class="underline decoration-[#C7A76D]/70 underline-offset-4 hover:text-[#C7A76D]" href={item.path}>{item.title}</a></li>)}
              </ul>
            </div>
          )}
          {video && <p class="text-sm leading-7 text-[#D7CEBF]">{bg ? "Документирани видеоматериали са представени и в публикациите за концерти." : "Documented video material is also available in the concert publications."}</p>}
          {musicIndex && <a class="inline-flex border-b border-[#C7A76D] py-2 text-[#F0E8D9]" href={bg ? "/bg/recordings/" : "/en/recordings/"}>{bg ? "Към дискографията" : "Visit the discography"}</a>}
          {contentLinks.length > 0 && (
            <div class="border-t border-[#C7A76D]/30 pt-8">
              <h2 class="mb-4 font-serif text-2xl text-[#F0E8D9]">{bg ? "Допълнителна информация" : "Further information"}</h2>
              <ul class="grid gap-2 break-all text-sm">
                {contentLinks.map((link) => <li><a href={link} target="_blank" rel="noopener noreferrer" class="text-[#C7A76D] underline underline-offset-4">{link}</a></li>)}
              </ul>
            </div>
          )}
        </article>
        <aside class="h-fit border border-[#C7A76D]/25 bg-[#122B22] p-6 text-sm leading-7 text-[#D7CEBF]">
          <h2 class="mb-4 font-serif text-xl text-[#F0E8D9]">{bg ? "Разгледайте още" : "Discover more"}</h2>
          <p>{bg ? "Първоначална публикация:" : "Original publication:"}</p>
          <a class="mt-2 block break-all text-[#C7A76D] underline underline-offset-4" href={record.originalUrl} target="_blank" rel="noopener noreferrer">{bg ? "Към първоначалната публикация" : "View the original publication"}</a>
          <div class="mt-7 flex flex-col gap-3 border-t border-[#C7A76D]/25 pt-6">
            <a href={bg ? "/bg/archive/" : "/en/archive/"} class="underline underline-offset-4 hover:text-[#C7A76D]">{bg ? "Фотоархив" : "Photo archive"}</a>
            <a href={bg ? "/bg/recordings/" : "/en/recordings/"} class="underline underline-offset-4 hover:text-[#C7A76D]">{bg ? "Записи" : "Recordings"}</a>
            <a href={bg ? "/bg/press/" : "/en/press/"} class="underline underline-offset-4 hover:text-[#C7A76D]">{bg ? "Преса и документи" : "Press and documents"}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  {(gallery || concertPhotoPost) && (record.kind !== "gmedia_album" || galleryAlbumId !== undefined) && <LegacyWordPressPhotoGallery lang={lang} albumId={concertPhotoPost ? 1 : record.kind === "gmedia_album" ? galleryAlbumId : undefined} />}
  {video && <LegacyWordPressVideoGallery lang={lang} />}
  {musicIndex && <LegacyMusicCatalogue lang={lang} />}
</BaseLayout>
