---
import { audioArchive } from "../content/audioArchive";
import type { Language } from "../content/siteContent";

const { lang } = Astro.props as { lang: Language };
const isBg = lang === "bg";
const selectedReleases = [
  {
    title: audioArchive.featuredBandcamp.title,
    year: audioArchive.featuredBandcamp.year,
    url: audioArchive.featuredBandcamp.url
  },
  {
    title: audioArchive.bandcamp[0].title,
    year: audioArchive.bandcamp[0].year,
    url: audioArchive.bandcamp[0].url
  }
];
---

<section id="recordings" class="border-b border-brand-border bg-brand-surface py-12 md:py-16" aria-labelledby="recordings-heading">
  <div class="container">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">
      {isBg ? "Записи · Bandcamp" : "Recordings · Bandcamp"}
    </p>
    <h2 id="recordings-heading" class="mt-3 max-w-4xl font-serif text-3xl text-brand-primary md:text-5xl">
      {isBg ? "Слушайте музиката. Купете записите." : "Hear the music. Buy the recordings."}
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-8 text-brand-muted">
      {isBg
        ? "Избрани архивни издания на оркестъра са достъпни за прослушване и покупка в Bandcamp. Всяка покупка е конкретен начин да подкрепите бъдещата ни работа."
        : "Selected recordings from the orchestra's archive are available to listen to and purchase on Bandcamp. Every purchase is a concrete way to support future work."}
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {selectedReleases.map((release) => (
        <article class="flex flex-col justify-between border border-brand-border bg-white p-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-brand-accent">{isBg ? "Архивен албум" : "Archive album"} · {release.year}</p>
            <h3 class="mt-3 font-serif text-xl leading-snug text-brand-primary">{release.title}</h3>
          </div>
          <a
            class="mt-6 inline-flex min-h-11 w-fit items-center border border-brand-primary bg-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-white hover:bg-brand-primaryHover"
            href={release.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {isBg ? "Слушайте и купете албума" : "Listen & buy this album"}
          </a>
        </article>
      ))}
    </div>
    <a
      class="mt-7 inline-flex min-h-11 items-center border border-brand-primary px-5 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-brand-primary hover:bg-brand-bg"
      href={audioArchive.bandcampProfile}
      target="_blank"
      rel="noopener noreferrer"
    >
      {isBg ? "Цялата дискография в Bandcamp" : "Full discography on Bandcamp"}
    </a>
  </div>
</section>
