---
import Section from "./Section.astro";
import AudioEmbedCard from "./AudioEmbedCard.astro";
import PhotoGrid from "./PhotoGrid.astro";
import { audioArchive, mediaArchiveCopy } from "../content/audioArchive";
import { photoArchive } from "../content/photoArchive";
import type { Language } from "../content/siteContent";

const { lang } = Astro.props as { lang: Language };
const copy = mediaArchiveCopy[lang];
---

<Section id="media-archive" eyebrow={copy.eyebrow} heading={copy.heading} tone="ruled">
  <div class="space-y-10">
    <div class="space-y-6 text-lg leading-9 text-brand-muted">
      {copy.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <article class="border border-brand-border border-l-4 border-l-brand-borderWarm bg-brand-surface p-6 md:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{copy.featuredLabel}</p>
      <h3 class="mt-4 font-serif text-3xl leading-tight text-brand-primary">{audioArchive.featuredBandcamp.title}</h3>
      <p class="mt-4 text-base leading-8 text-brand-muted">{audioArchive.featuredBandcamp.description}</p>
      <p class="mt-3 text-sm leading-6 text-brand-muted">{audioArchive.featuredBandcamp.credits}</p>
      <div class="mt-6 grid gap-3 text-sm leading-6 text-brand-muted sm:grid-cols-2">
        {audioArchive.featuredBandcamp.tracks.map((track) => (
          <div class="flex justify-between gap-4 border-t border-brand-border pt-3">
            <span>{track.title}</span>
            <span class="font-mono text-xs text-brand-accent">{track.duration}</span>
          </div>
        ))}
      </div>
      <a
        class="mt-8 inline-flex min-h-11 items-center border border-brand-primary bg-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-white transition hover:border-brand-primaryHover hover:bg-brand-primaryHover"
        href={audioArchive.featuredBandcamp.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.listenOnBandcamp}
      </a>
    </article>

    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <section aria-labelledby="bandcamp-archive-heading">
        <h3 id="bandcamp-archive-heading" class="font-serif text-3xl text-brand-primary">{copy.bandcampHeading}</h3>
        <p class="mt-4 text-base leading-8 text-brand-muted">{copy.bandcampText}</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {audioArchive.bandcamp.map((item) => (
            <AudioEmbedCard item={item} label={copy.listenOnBandcamp} sourceLabel={copy.sourceLabel} />
          ))}
        </div>
        <a
          class="mt-6 inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent"
          href={audioArchive.bandcampProfile}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.openBandcamp}
        </a>
      </section>

      <section aria-labelledby="soundcloud-archive-heading">
        <h3 id="soundcloud-archive-heading" class="font-serif text-3xl text-brand-primary">{copy.soundcloudHeading}</h3>
        <p class="mt-4 text-base leading-8 text-brand-muted">{copy.soundcloudText}</p>
        <div class="mt-6">
          {audioArchive.soundcloud.map((item) => (
            <AudioEmbedCard item={item} label={copy.listenOnSoundCloud} sourceLabel={copy.sourceLabel} />
          ))}
        </div>
        <a
          class="mt-6 inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent"
          href={audioArchive.soundcloudProfile}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.openSoundCloud}
        </a>
      </section>
    </div>

    <section aria-labelledby="legacy-photo-archive-heading">
      <h3 id="legacy-photo-archive-heading" class="font-serif text-3xl text-brand-primary">{copy.photosHeading}</h3>
      <p class="mt-4 max-w-3xl text-base leading-8 text-brand-muted">{copy.photosText}</p>
      <div class="mt-6">
        <PhotoGrid photos={photoArchive.photos} />
      </div>
    </section>
  </div>
</Section>
