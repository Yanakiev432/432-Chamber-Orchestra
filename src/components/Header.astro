---
import LanguageSwitch from "./LanguageSwitch.astro";
import type { Language } from "../content/siteContent";

type Props = {
  lang: Language;
  nav: { label: string; href: string }[];
  alternateLang: Language;
  alternateHref: string;
};

const { lang, nav, alternateLang, alternateHref } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-brand-border bg-brand-surface shadow-sm">
  <div class="container flex min-h-20 items-center justify-between gap-4">
    <a class="font-serif text-xl leading-none text-brand-primary" href={lang === "bg" ? "/bg/" : "/en/"} aria-label="432 Chamber Orchestra home">
      432
      <span class="block text-xs uppercase tracking-[0.12em] text-brand-muted">Chamber Orchestra</span>
    </a>
    <nav class="hidden items-center gap-5 xl:flex" aria-label={lang === "bg" ? "Основна навигация" : "Main navigation"}>
      {nav.map((item) => (
        <a class="text-xs font-semibold uppercase tracking-[0.06em] text-brand-muted transition hover:text-brand-primary focus-visible:text-brand-primary" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <details class="relative z-[60] xl:hidden">
        <summary class="flex min-h-10 cursor-pointer list-none items-center border border-brand-primary bg-brand-surface px-3 text-sm font-semibold uppercase tracking-[0.06em] text-brand-primary transition hover:bg-brand-bg">
          {lang === "bg" ? "Меню" : "Menu"}
        </summary>
        <nav class="absolute right-0 z-[60] mt-3 grid w-72 max-w-[calc(100vw-2rem)] gap-1 border border-brand-border bg-brand-surface p-3 text-brand-text shadow-2xl" aria-label={lang === "bg" ? "Мобилна навигация" : "Mobile navigation"}>
          {nav.map((item) => (
            <a class="px-3 py-3 text-sm font-medium leading-5 tracking-normal text-brand-text transition hover:bg-brand-bg hover:text-brand-primary" href={item.href}>{item.label}</a>
          ))}
        </nav>
      </details>
      <LanguageSwitch lang={lang} alternateLang={alternateLang} alternateHref={alternateHref} />
    </div>
  </div>
</header>
