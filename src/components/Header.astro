---
import LanguageSwitch from "./LanguageSwitch.astro";
import type { Language } from "../content/siteContent";

type Props = {
  lang: Language;
  nav: { label: string; href: string }[];
  alternateLang: Language;
  alternateHref: string;
};

const { lang, nav, alternateLang, alternateHref } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-ink/15 bg-ivory/95 backdrop-blur">
  <div class="container flex min-h-20 items-center justify-between gap-4">
    <a class="font-serif text-xl leading-none" href={lang === "bg" ? "/bg/" : "/en/"} aria-label="432 Chamber Orchestra home">
      432
      <span class="block text-xs uppercase tracking-[0.24em] text-graphite">Chamber Orchestra</span>
    </a>
    <nav class="hidden items-center gap-5 xl:flex" aria-label={lang === "bg" ? "Основна навигация" : "Main navigation"}>
      {nav.map((item) => (
        <a class="text-xs font-semibold uppercase tracking-[0.12em] text-graphite transition hover:text-burgundy" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <details class="relative xl:hidden">
        <summary class="flex min-h-10 cursor-pointer list-none items-center border border-ink/20 px-3 text-xs font-semibold uppercase tracking-[0.16em]">
          {lang === "bg" ? "Меню" : "Menu"}
        </summary>
        <nav class="absolute right-0 mt-3 grid w-64 gap-1 border border-ink/15 bg-ivory p-3 shadow-xl" aria-label={lang === "bg" ? "Мобилна навигация" : "Mobile navigation"}>
          {nav.map((item) => (
            <a class="px-3 py-2 text-sm hover:bg-warm/40" href={item.href}>{item.label}</a>
          ))}
        </nav>
      </details>
      <LanguageSwitch lang={lang} alternateLang={alternateLang} alternateHref={alternateHref} />
    </div>
  </div>
</header>
