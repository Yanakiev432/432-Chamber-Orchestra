---
type Props = {
  id?: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  tone?: "light" | "ruled" | "dark";
};

const { id, eyebrow, heading, intro, tone = "light" } = Astro.props;

const toneClass = {
  light: "bg-[#091F19] text-brand-text",
  ruled: "bg-[#122B22] text-brand-text",
  dark: "bg-[#17392C] text-brand-text"
};
---

<section id={id} class={`${toneClass[tone]} border-t border-brand-border py-20 md:py-28`}>
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-[0.78fr_1.22fr]">
      <header>
        {eyebrow && <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">{eyebrow}</p>}
        <h2 class={"font-serif text-3xl leading-tight text-brand-primary md:text-5xl"}>{heading}</h2>
        {intro && <p class="mt-6 max-w-xl text-base leading-8 opacity-75">{intro}</p>}
      </header>
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</section>
