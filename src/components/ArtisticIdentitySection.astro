---
import Section from "./Section.astro";
import type { siteContent } from "../content/siteContent";

type Copy = typeof siteContent.bg.artisticIdentity;
const { section } = Astro.props as { section: Copy };
---

<Section id={section.id} eyebrow={section.eyebrow} heading={section.heading}>
  <div class="space-y-6 text-lg leading-9 text-graphite">
    {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <p class="mt-10 border border-burgundy/40 bg-burgundy/5 p-6 text-base font-semibold leading-8 text-burgundy">
    {section.disclaimer}
  </p>
</Section>
