---
type Props = {
  href: string;
  variant?: "primary" | "secondary" | "text";
  label: string;
  external?: boolean;
};

const { href, variant = "primary", label, external = false } = Astro.props;

const classes = {
  primary:
    "relative inline-flex min-h-11 items-center justify-center border border-brand-accent bg-brand-accent px-5 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-[#091F19] shadow-lg shadow-black/20 transition hover:border-brand-primaryHover hover:bg-brand-primaryHover focus-visible:outline-brand-accent",
  secondary:
    "inline-flex min-h-11 items-center justify-center border border-brand-accent/60 bg-[#122B22] px-5 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-brand-text transition hover:border-brand-accent hover:bg-brand-surface focus-visible:outline-brand-accent",
  text:
    "inline-flex items-center text-sm font-semibold uppercase tracking-[0.06em] text-brand-accent underline decoration-brand-accent underline-offset-4 transition hover:text-brand-accent focus-visible:outline-brand-accent"
};
---

<a class={classes[variant]} href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{label}</a>
