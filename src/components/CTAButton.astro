---
type Props = {
  href: string;
  variant?: "primary" | "secondary" | "text";
  label: string;
};

const { href, variant = "primary", label } = Astro.props;

const classes = {
  primary:
    "relative inline-flex min-h-11 items-center justify-center border border-brand-primary bg-brand-primary px-5 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-white shadow-sm transition hover:border-brand-primaryHover hover:bg-brand-primaryHover focus-visible:outline-brand-accent",
  secondary:
    "inline-flex min-h-11 items-center justify-center border border-brand-primary bg-brand-surface px-5 py-3 text-sm font-semibold uppercase tracking-[0.06em] text-brand-primary transition hover:bg-brand-bg focus-visible:outline-brand-accent",
  text:
    "inline-flex items-center text-sm font-semibold uppercase tracking-[0.06em] text-brand-primary underline decoration-brand-accent underline-offset-4 transition hover:text-brand-accent focus-visible:outline-brand-accent"
};
---

<a class={classes[variant]} href={href}>{label}</a>
