---
import gallery from "../content/legacyGallery.json";
import type { Language } from "../content/siteContent";
const { lang, albumId } = Astro.props as { lang: Language; albumId?: number };
const bg = lang === "bg";
const albums = albumId ? gallery.albums.filter((a) => a.id === albumId) : gallery.albums;
const names: Record<number, { bg: string; en: string }> = {
  1: { bg: "Студио 5, НДК · 13 март 2016 г.", en: "Studio 5, Sofia · 13 March 2016" },
  6: { bg: "„Български съвременници в 432 Hz“", en: "Contemporary Bulgarian Composers in 432 Hz" }
};
---
<section id="wordPress-photo-gallery" class="border-t border-[#C7A76D]/25 bg-[#122B22] py-14 md:py-20">
  <div class="container">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#C7A76D]">{bg ? "Исторически фотоархив" : "Historical photo archive"}</p>
    <h2 class="max-w-4xl font-serif text-3xl leading-tight text-[#F0E8D9] md:text-5xl">
      {bg ? "Кадри от концертите" : "Concert photographs"}
    </h2>
    <p class="mt-5 max-w-3xl text-base leading-8 text-[#D7CEBF]">
      {bg
        ? "Фотографии от концертни изяви на Камерен оркестър 432."
        : "Photographs from performances by 432 Chamber Orchestra."}
    </p>
    <div class="mt-12 space-y-14">
      {albums.map((album) => (
        <section aria-label={names[album.id]?.[lang] || album.name}>
          <div class="mb-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#C7A76D]/30 pb-4">
            <h3 class="font-serif text-2xl text-[#F0E8D9] md:text-3xl">{names[album.id]?.[lang] || album.name}</h3>
            <p class="text-sm text-[#D7CEBF]">{album.images.length} {bg ? "фотографии" : "photographs"}</p>
          </div>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
            {album.images.map((item, photoIndex) => (
              <a class="group block overflow-hidden border border-[#C7A76D]/20 bg-[#091F19] transition hover:border-[#C7A76D]" href={item.src} target="_blank" rel="noopener noreferrer" title={names[album.id]?.[lang] || album.name}>
                <img class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.015]" src={item.src} alt={(names[album.id]?.[lang] || album.name) + " — " + (bg ? "фотография " : "photograph ") + (photoIndex + 1)} loading="lazy" decoding="async" width="480" height="360" />
              </a>
            ))}
          </div>
        </section>
      ))}
      {!albumId && gallery.unassigned.length > 0 && (
        <section aria-label={bg ? "Други фотографии" : "Additional photographs"}>
          <h3 class="mb-5 border-b border-[#C7A76D]/30 pb-4 font-serif text-2xl text-[#F0E8D9]">{bg ? "Други фотографии" : "Additional photographs"}</h3>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
            {gallery.unassigned.map((photo) => (
              <a class="block overflow-hidden border border-[#C7A76D]/20" href={photo.src} target="_blank" rel="noopener noreferrer" title={photo.title}>
                <img class="aspect-[4/3] w-full object-cover" src={photo.src} alt={photo.title} loading="lazy" decoding="async" width="480" height="360" />
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</section>
