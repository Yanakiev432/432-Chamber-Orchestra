---
import PhotoGrid from "./PhotoGrid.astro";
import Section from "./Section.astro";
import {
  photoArchive,
  photoArchiveCategories,
  photoArchivePageCopy
} from "../content/photoArchive";
import type { Language } from "../content/siteContent";

const { lang } = Astro.props as { lang: Language };
const copy = photoArchivePageCopy[lang];
---

<Section id="photo-archive" eyebrow={lang === "bg" ? "Архив" : "Archive"} heading={copy.title} tone="ruled">
  <div class="space-y-6 text-lg leading-9 text-brand-muted">
    {copy.intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="mt-12 space-y-14">
    {photoArchiveCategories.map((category) => {
      const photos = photoArchive.filter((photo) => photo.category === category.key);
      return (
        <section aria-labelledby={`photo-category-${category.key}`}>
          <div class="mb-6 border-t border-brand-border pt-6">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">
              {category.label[lang]}
            </p>
            <h2 id={`photo-category-${category.key}`} class="mt-3 font-serif text-3xl text-brand-primary">
              {category.label[lang]}
            </h2>
          </div>
          <PhotoGrid photos={photos} lang={lang} />
        </section>
      );
    })}
  </div>
</Section>
