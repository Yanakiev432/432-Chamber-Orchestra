---
const {
  url,
  title,
  type = "track"
} = Astro.props as {
  url: string;
  title: string;
  type?: "track" | "playlist";
};

const widgetUrl =
  `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}` +
  `&color=%23123c3c` +
  `&auto_play=false` +
  `&hide_related=true` +
  `&show_comments=false` +
  `&show_user=true` +
  `&show_reposts=false` +
  `&show_teaser=false` +
  `&visual=false`;

const height = type === "playlist" ? "300" : "166";
---

<iframe
  class="block w-full border-0"
  title={title}
  width="100%"
  height={height}
  allow="autoplay"
  loading="lazy"
  src={widgetUrl}
></iframe>
