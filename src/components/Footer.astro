---
import type { siteContent } from "../content/siteContent";

type FooterCopy = typeof siteContent.bg.footer;

type Props = {
  footer: FooterCopy;
};

const { footer } = Astro.props;
---

<footer class="border-t border-ink/15 bg-graphite py-12 text-ivory">
  <div class="container grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-serif text-2xl">{footer.orchestraName}</p>
      <p class="mt-3 text-sm leading-6 text-ivory/70">{footer.orchestraLine}</p>
    </div>
    <div>
      <p class="font-serif text-xl">{footer.foundationName}</p>
      <p class="mt-3 text-sm leading-6 text-ivory/70">{footer.foundationLine}</p>
    </div>
    <div>
      <ul class="space-y-2 text-sm leading-6 text-ivory/80">
        {footer.legalLines.map((line) => <li>{line}</li>)}
      </ul>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-gold">{footer.motto}</p>
    </div>
  </div>
</footer>
