---
import type { siteContent } from "../content/siteContent";
import { brandAssets } from "../content/brandAssets";

type FooterCopy = typeof siteContent.bg.footer;

type Props = {
  footer: FooterCopy;
};

const { footer } = Astro.props;
---

<footer class="border-t border-brand-primary bg-brand-primary py-12 text-white">
  <div class="container grid gap-10 md:grid-cols-3">
    <div>
      <img class="h-auto w-[190px] max-w-full" src={brandAssets.footerLogo} width="190" height="33" alt="432 Chamber Orchestra" loading="lazy" decoding="async" />
      <p class="mt-3 text-sm leading-6 text-white/75">{footer.orchestraLine}</p>
    </div>
    <div>
      <img class="h-auto w-[150px] max-w-full opacity-95" src={brandAssets.foundation.logoDark} width="150" height="25" alt="Foundation 432 Hertz" loading="lazy" decoding="async" />
      <p class="sr-only">{footer.foundationName}</p>
      <p class="mt-3 text-sm leading-6 text-white/75">{footer.foundationLine}</p>
    </div>
    <div>
      <ul class="space-y-2 text-sm leading-6 text-white/80">
        {footer.legalLines.map((line) => <li>{line}</li>)}
      </ul>
      <nav class="mt-6" aria-label="Footer">
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm leading-6 text-white/80">
          {footer.links.map((link) => (
            <li>
              <a class="underline-offset-4 transition hover:text-white hover:underline" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{footer.motto}</p>
    </div>
  </div>
</footer>
