---
import Section from "./Section.astro";
import type { siteContent } from "../content/siteContent";

type Copy = typeof siteContent.bg.founder;

const { section } = Astro.props as { section: Copy };
---

<Section id={section.id} eyebrow={section.eyebrow} heading={section.heading} tone="ruled">
  <article class="grid gap-8 border border-brand-border bg-white p-6 md:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <figure class="border border-brand-border bg-brand-surface p-2">
      <img
        class="aspect-[4/3] w-full object-cover"
        src={section.photo.src}
        width={section.photo.width}
        height={section.photo.height}
        alt={section.photo.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.role}</p>
      <h3 class="mt-3 font-serif text-3xl leading-tight text-brand-primary">{section.name}</h3>
      <div class="mt-6 space-y-5 text-base leading-8 text-brand-muted">
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </article>
</Section>
