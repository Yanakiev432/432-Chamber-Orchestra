---
import CTAButton from "./CTAButton.astro";
import { audioArchive } from "../content/audioArchive";
import type { siteContent } from "../content/siteContent";

type HeroCopy = typeof siteContent.bg.hero;

type Props = {
  hero: HeroCopy;
  lang: "bg" | "en";
};

const { hero, lang } = Astro.props;
---

<section class="relative z-0 overflow-hidden border-b border-brand-border bg-brand-bg py-14 md:py-20">
  <div class="container grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
    <div>
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.1em] text-brand-accent">{hero.eyebrow}</p>
      <h1 class="max-w-[11ch] break-words font-serif text-[clamp(3rem,7vw,6.5rem)] leading-[0.95] text-brand-primary">{hero.title}</h1>
      <p class="mt-8 max-w-xl text-xl leading-9 text-brand-muted">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <CTAButton href={audioArchive.bandcampProfile} label={lang === "bg" ? "Слушайте и купете записи" : "Listen & buy recordings"} external />
        <CTAButton href="#listening-circle" label={hero.primaryCta} variant="secondary" />
        <CTAButton href="#support" label={hero.secondaryCta} variant="text" />
      </div>
    </div>
    <aside class="border border-brand-border border-l-4 border-l-brand-borderWarm bg-brand-surface px-6 py-8">
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent before:h-px before:w-8 before:bg-brand-borderWarm">{hero.campaignLabel}</p>
      <ul class="mt-8 space-y-5 font-serif text-2xl leading-snug">
        {hero.positioning.map((line) => <li class="border-b border-brand-border pb-4 text-brand-primary">{line}</li>)}
      </ul>
      <p class="mt-8 text-base leading-8 text-brand-muted">{hero.finalLine}</p>
    </aside>
  </div>
</section>
