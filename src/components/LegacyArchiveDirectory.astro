---
import archive from "../content/legacyArchive.json";
import type { Language } from "../content/siteContent";
const { lang } = Astro.props as { lang: Language };
const bg = lang === "bg";
const groups = [
  { kind: "event", name: bg ? "Концерти" : "Concerts", note: bg ? "Документирани концертни събития" : "Documented concert events" },
  { kind: "event_view", name: bg ? "Концертен календар" : "Concert calendar", note: bg ? "Историческият календар на оркестъра" : "The orchestra historical concert calendar" },
  { kind: "event_category", name: bg ? "Концертни категории" : "Concert categories", note: bg ? "Историческите категории от календарния архив" : "Categories from the historical calendar" },
  { kind: "post", name: bg ? "Публикации" : "Articles and news", note: bg ? "Документирани концерти, записи и събития" : "Documented concerts, recordings and events" },
  { kind: "product", name: bg ? "Исторически каталог" : "Historical catalogue", note: bg ? "Публикуваните музикални записи, с препратка към Bandcamp" : "Original recording pages linked to Bandcamp" },
  { kind: "page", name: bg ? "Страници и история" : "Pages and history", note: bg ? "Биографии, концертни програми, видео и документи" : "Biographies, concert programmes, video and documents" },
  { kind: "taxonomy", name: bg ? "Категории и тематични архиви" : "Categories and topical archives", note: bg ? "Каталогизиране по жанрове и репертоар" : "Catalogue classifications by repertoire and genre" }
] as const;
const items = archive.items.filter((item) => item.language === lang && !item.dynamicWordPress && (item.kind !== "event_view" || item.path === "/"+lang+"/events/"));
const sections = groups.map((group) => ({...group, items: items.filter((item) => item.kind === group.kind)})).filter((group) => group.items.length);

---
<section id="legacy-archive-directory" class="border-t border-[#C7A76D]/30 bg-[#091F19] py-16 md:py-24">
  <div class="container">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#C7A76D]">{bg ? "Документален архив" : "Documentary archive"}</p>
    <h2 class="mt-4 max-w-3xl font-serif text-3xl text-[#F0E8D9] md:text-5xl">
      {bg ? "Публикации, история и записи" : "Publications, history and recordings"}
    </h2>
    <p class="mt-5 max-w-3xl text-base leading-8 text-[#D7CEBF]">
      {bg
        ? "Страници от историята на оркестъра — концертни програми, музикални записи, фотографии и публикации."
        : "Pages from the orchestra’s history — concert programmes, recordings, photographs and publications."}
    </p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {sections.map((group) => (
        <details class="group border border-[#C7A76D]/30 bg-[#122B22] p-6" open={group.kind === "post"}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-5 font-serif text-xl text-[#F0E8D9] marker:hidden">
            <span>{group.name}<span class="ml-3 align-middle font-sans text-xs text-[#C7A76D]">{group.items.length}</span></span>
            <span aria-hidden="true" class="font-sans text-lg text-[#C7A76D] group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2 text-sm leading-6 text-[#D7CEBF]">{group.note}</p>
          <ul class="mt-6 grid gap-3 border-t border-[#C7A76D]/20 pt-5">
            {group.items.map((item) => (
              <li>
                <a class="inline-flex min-h-8 items-center gap-2 text-sm leading-6 text-[#D7CEBF] underline decoration-[#C7A76D]/40 underline-offset-4 transition hover:text-[#C7A76D]" href={item.path}>{item.title}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>
</section>
