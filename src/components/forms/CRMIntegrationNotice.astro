---
const { message, tone = "light", id } = Astro.props as {
  message: string;
  tone?: "light" | "dark";
  id?: string;
};

const classes =
  tone === "dark"
    ? "border border-brand-borderWarm bg-brand-warm p-4 text-sm leading-6 text-brand-primary"
    : "border border-brand-borderWarm bg-brand-warm p-4 text-sm leading-6 text-brand-muted";
---

<p id={id} class={classes} role="status">{message}</p>
