---
import CRMIntegrationNotice from "./CRMIntegrationNotice.astro";
import { crmConfig, listeningCircleCopy, type FormSource } from "../../content/crmConfig";
import type { Language } from "../../content/siteContent";

const {
  lang,
  source,
  tone = "light",
  heading
} = Astro.props as {
  lang: Language;
  source: FormSource;
  tone?: "light" | "dark";
  heading?: string;
};

const copy = listeningCircleCopy[lang];
const actionEndpoint = crmConfig.brevo.listeningFormAction;
const externalFormUrl = crmConfig.brevo.listeningFormUrl;
const contactEmail = crmConfig.contactEmail;
const hasActionEndpoint = Boolean(actionEndpoint);
const hasExternalFormUrl = Boolean(externalFormUrl);
const statusId = `crm-form-status-${source}`;
const emailHref = `mailto:${contactEmail}?subject=${encodeURIComponent(copy.emailSubject)}`;
const borderClass = tone === "dark" ? "border-white/30" : "border-brand-border";
const surfaceClass = tone === "dark" ? "" : "bg-brand-surface";
const labelClass = tone === "dark" ? "text-white/80" : "text-brand-muted";
const fieldClass =
  tone === "dark"
    ? "min-h-11 border border-brand-border bg-brand-surface px-3 text-brand-text"
    : "min-h-11 border border-brand-border bg-brand-surface px-3 text-brand-text";
const primaryButtonClass = tone === "dark"
  ? "inline-flex min-h-11 items-center justify-center border border-white bg-white px-5 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-brand-primary transition hover:border-brand-borderWarm hover:bg-brand-bg"
  : "inline-flex min-h-11 items-center justify-center border border-brand-primary bg-brand-primary px-5 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-white transition hover:border-brand-primaryHover hover:bg-brand-primaryHover";
const secondaryButtonClass = tone === "dark"
  ? "inline-flex min-h-11 items-center justify-center border border-white/40 px-5 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-white transition hover:border-white"
  : "inline-flex min-h-11 items-center justify-center border border-brand-primary px-5 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent";
const buttonClass = hasActionEndpoint
  ? tone === "dark"
    ? primaryButtonClass
    : primaryButtonClass
  : hasExternalFormUrl
    ? primaryButtonClass
    : secondaryButtonClass;
const statusMessage = hasActionEndpoint ? copy.activeStatus : hasExternalFormUrl ? copy.externalStatus : copy.inactiveStatus;
---

<form
  class={`grid gap-5 border ${borderClass} ${surfaceClass} p-6 md:p-8`}
  method={hasActionEndpoint ? "post" : undefined}
  action={hasActionEndpoint ? actionEndpoint : undefined}
  aria-describedby={statusId}
>
  <h2 class={tone === "dark" ? "font-serif text-3xl leading-tight text-white md:text-4xl" : "font-serif text-3xl leading-tight text-brand-primary md:text-4xl"}>{heading ?? copy.heading}</h2>
  <input type="hidden" name="SOURCE" value={source} />
  <input type="hidden" name="LEAD_TYPE" value="listener" />
  <input type="hidden" name="CONSENT_SOURCE" value="website_form" />

  <div class="grid gap-5 sm:grid-cols-2">
    <label class={`grid gap-2 text-sm ${labelClass}`}>
      {copy.firstName}
      <input class={fieldClass} type="text" name="FIRSTNAME" autocomplete="given-name" required />
    </label>
    <label class={`grid gap-2 text-sm ${labelClass}`}>
      {copy.lastName}
      <input class={fieldClass} type="text" name="LASTNAME" autocomplete="family-name" />
    </label>
  </div>

  <label class={`grid gap-2 text-sm ${labelClass}`}>
    {copy.email}
    <input class={fieldClass} type="email" name="EMAIL" autocomplete="email" required />
  </label>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class={`grid gap-2 text-sm ${labelClass}`}>
      {copy.language}
      <select class={fieldClass} name="LANGUAGE">
        <option value="bg" selected={lang === "bg"}>Български</option>
        <option value="en" selected={lang === "en"}>English</option>
      </select>
    </label>
    <label class={`grid gap-2 text-sm ${labelClass}`}>
      {copy.helpType}
      <select class={fieldClass} name="HELP_TYPE">
        {copy.options.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
  </div>

  <label class={`grid gap-2 text-sm ${labelClass}`}>
    {copy.message}
    <textarea
      class={`${fieldClass} min-h-32 py-3`}
      name="MESSAGE"
      maxlength="1500"
    ></textarea>
  </label>

  <label class={`flex gap-3 text-sm leading-6 ${labelClass}`}>
    <input class="mt-1 size-4 shrink-0" type="checkbox" name="CONSENT" value="yes" required />
    <span>{copy.privacy}</span>
  </label>

  <CRMIntegrationNotice
    id={statusId}
    tone={tone}
    message={statusMessage}
  />

  {
    hasActionEndpoint ? (
      <button class={buttonClass} type="submit">{copy.submit}</button>
    ) : hasExternalFormUrl ? (
      <a class={buttonClass} href={externalFormUrl} target="_blank" rel="noopener noreferrer">{copy.externalCta}</a>
    ) : (
      <a class={buttonClass} href={emailHref}>{copy.emailCta}</a>
    )
  }
</form>
