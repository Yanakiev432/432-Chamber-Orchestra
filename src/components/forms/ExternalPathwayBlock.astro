---
import CRMIntegrationNotice from "./CRMIntegrationNotice.astro";

const { heading, text, button, fallback, fallbackButton, fallbackSubject, url } = Astro.props as {
  heading: string;
  text: string;
  button: string;
  fallback: string;
  fallbackButton: string;
  fallbackSubject: string;
  url?: string;
};

const isActive = Boolean(url);
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "info@432hz-foundation.com";
const fallbackHref = `mailto:${contactEmail}?subject=${encodeURIComponent(fallbackSubject)}`;
---

<article class="flex min-h-full flex-col border border-brand-border bg-brand-surface p-6">
  <h3 class="font-serif text-2xl text-brand-primary">{heading}</h3>
  <p class="mt-4 flex-1 text-base leading-8 text-brand-muted">{text}</p>
  {
    isActive ? (
      <a
        class="mt-6 inline-flex min-h-11 w-fit items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {button}
      </a>
    ) : (
      <div class="mt-6 grid gap-4">
        <CRMIntegrationNotice message={fallback} />
        <a
          class="inline-flex min-h-11 w-fit items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent"
          href={fallbackHref}
        >
          {fallbackButton}
        </a>
      </div>
    )
  }
</article>
