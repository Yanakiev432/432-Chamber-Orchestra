---
import Section from "./Section.astro";
import ExpertiseOfferBlock from "./forms/ExpertiseOfferBlock.astro";
import HostSuggestionBlock from "./forms/HostSuggestionBlock.astro";
import ListeningCircleForm from "./forms/ListeningCircleForm.astro";
import SponsorReferralBlock from "./forms/SponsorReferralBlock.astro";
import type { Language, siteContent } from "../content/siteContent";
import { getBankRows } from "../content/siteContent";

type Copy = typeof siteContent.bg.support;

const { section, lang } = Astro.props as { section: Copy; lang: Language };
const rows = getBankRows(lang);
const source = lang === "bg" ? "support_bg" : "support_en";
---

<Section id={section.id} eyebrow={section.eyebrow} heading={section.heading} intro={section.intro} tone="dark">
  <div class="space-y-10">
    <ListeningCircleForm lang={lang} source={source} tone="dark" />

    <div class="grid gap-4 md:grid-cols-2">
      <ExpertiseOfferBlock lang={lang} />
      <HostSuggestionBlock lang={lang} />
    </div>

    <SponsorReferralBlock lang={lang} />

    <article class="border border-brand-borderWarm bg-brand-warm p-6 text-brand-text md:p-8">
      <h3 class="font-serif text-3xl text-brand-primary">{section.bankHeading}</h3>
      <p class="mt-4 max-w-2xl text-base leading-8 text-brand-muted">{section.bankText}</p>
      <dl class="mt-8 grid gap-4">
        {rows.map((row) => (
          <div class="grid gap-2 border-t border-brand-borderWarm pt-4 sm:grid-cols-[180px_1fr]">
            <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-primary">{row.label}</dt>
            <dd class="break-words font-mono text-sm">{row.value}</dd>
          </div>
        ))}
      </dl>
    </article>

    <article class="border border-white/30 p-6">
      <h3 class="font-serif text-2xl text-white">{section.paymentPlaceholderHeading}</h3>
      <p class="mt-4 text-base leading-8 text-white/80">{section.paymentPlaceholder}</p>
    </article>

    <article class="border border-white/30 p-6">
      <h3 class="font-serif text-2xl text-white">{section.patronHeading}</h3>
      <p class="mt-4 text-base leading-8 text-white/80">{section.patronText}</p>
      <a
        class="mt-6 inline-flex min-h-11 items-center border border-white px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-white transition hover:border-brand-accent hover:text-brand-accent"
        href="mailto:info@432hz-foundation.com"
      >
        info@432hz-foundation.com
      </a>
    </article>
  </div>
</Section>
