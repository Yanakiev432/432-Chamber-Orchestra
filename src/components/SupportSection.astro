---
import Section from "./Section.astro";
import ExpertiseOfferBlock from "./forms/ExpertiseOfferBlock.astro";
import HostSuggestionBlock from "./forms/HostSuggestionBlock.astro";
import ListeningCircleForm from "./forms/ListeningCircleForm.astro";
import SponsorReferralBlock from "./forms/SponsorReferralBlock.astro";
import type { Language, siteContent } from "../content/siteContent";
import { brandAssets } from "../content/brandAssets";
import { getBankRows } from "../content/siteContent";

type Copy = typeof siteContent.bg.support;

const { section, lang } = Astro.props as { section: Copy; lang: Language };
const rows = getBankRows(lang);
const source = lang === "bg" ? "support_bg" : "support_en";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "info@432hz-foundation.com";
const sponsorHref = `mailto:${contactEmail}?subject=${encodeURIComponent(section.fundraising.patronPathway.mailSubject)}`;
const briefHref = lang === "bg" ? "/bg/sponsor-brief/" : "/en/sponsor-brief/";
const certificateHref = lang === "bg" ? "/bg/donation-certificate/" : "/en/donation-certificate/";
const policyHref = lang === "bg" ? "/bg/donation-policy/" : "/en/donation-policy/";
---

<Section id={section.id} eyebrow={section.eyebrow} heading={section.heading} intro={section.intro} tone="ruled">
  <div class="space-y-10">
    <ListeningCircleForm lang={lang} source={source} />

    <div class="grid gap-4 md:grid-cols-2">
      <ExpertiseOfferBlock lang={lang} />
      <HostSuggestionBlock lang={lang} />
    </div>

    <SponsorReferralBlock lang={lang} />

    <div class="grid gap-6">
      <article class="border border-brand-border border-l-4 border-l-brand-borderWarm bg-brand-surface p-6 text-brand-text md:p-8">
        <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.preview.heading}</h3>
        <p class="mt-4 text-base leading-8 text-brand-muted">{section.fundraising.preview.intro}</p>
        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.preview.formatHeading}</p>
            <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted">
              {section.fundraising.preview.formatItems.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.preview.outputsHeading}</p>
            <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted">
              {section.fundraising.preview.outputItems.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
            </ul>
          </div>
        </div>
        <dl class="mt-8 grid gap-3 border-t border-brand-border pt-5 text-sm sm:grid-cols-3">
          {section.fundraising.preview.facts.map((fact) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-primary">{fact.label}</dt>
              <dd class="mt-1 text-brand-muted">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </article>

      <article class="border border-brand-border bg-brand-surface p-6 md:p-8">
        <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.returnProgramme.heading}</h3>
        <div class="mt-5 space-y-4 text-base leading-8 text-brand-muted">
          {section.fundraising.returnProgramme.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.returnProgramme.programmeHeading}</p>
            <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted">
              {section.fundraising.returnProgramme.programmeItems.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.returnProgramme.supportHeading}</p>
            <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted">
              {section.fundraising.returnProgramme.supportItems.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="mt-8 grid gap-4 text-sm leading-7 text-brand-muted md:grid-cols-2">
          <p class="border-l-2 border-brand-borderWarm pl-4">{section.fundraising.returnProgramme.confirmationNote}</p>
          <p class="border-l-2 border-brand-borderWarm pl-4">{section.fundraising.returnProgramme.archiveNote}</p>
        </div>
      </article>

      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
        <article class="border border-brand-border bg-brand-surface p-6 md:p-8">
          <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.useOfFunds.heading}</h3>
          <p class="mt-4 text-base leading-8 text-brand-muted">{section.fundraising.useOfFunds.intro}</p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.useOfFunds.label}</p>
          <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted sm:grid-cols-2">
            {section.fundraising.useOfFunds.items.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
          </ul>
        </article>

        <article class="border border-brand-border bg-brand-surface p-6 md:p-8">
          <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.patronPathway.heading}</h3>
          <p class="mt-4 text-base leading-8 text-brand-muted">{section.fundraising.patronPathway.intro}</p>
          <ul class="mt-6 grid gap-3 text-sm leading-6 text-brand-muted">
            {section.fundraising.patronPathway.items.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
          </ul>
          <div class="mt-6 border-l-2 border-brand-borderWarm pl-4">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.patronPathway.askLabel}</p>
            <p class="mt-2 text-sm leading-6 text-brand-muted">{section.fundraising.patronPathway.askText}</p>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="inline-flex min-h-11 items-center border border-brand-primary bg-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-white transition hover:border-brand-primaryHover hover:bg-brand-primaryHover" href={sponsorHref}>
              {section.fundraising.patronPathway.cta}
            </a>
            <a class="inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent" href={briefHref}>
              {section.fundraising.patronPathway.briefCta}
            </a>
          </div>
        </article>
      </div>

      <article class="border border-brand-border bg-brand-surface p-6 md:p-8">
        <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.fundingTarget.heading}</h3>
        <p class="mt-4 text-base leading-8 text-brand-muted">{section.fundraising.fundingTarget.intro}</p>
        <div class="mt-6 grid gap-4 lg:grid-cols-3">
          {section.fundraising.fundingTarget.items.map((item) => (
            <div class="border-t border-brand-border pt-4">
              <p class="font-serif text-xl text-brand-primary">{item.title}</p>
              <p class="mt-2 font-mono text-sm text-brand-accent">{item.amount}</p>
              <p class="mt-3 text-sm leading-6 text-brand-muted">{item.description}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 border-t border-brand-border pt-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{section.fundraising.fundingTarget.breakdownHeading}</p>
          <ul class="mt-4 grid gap-3 text-sm leading-6 text-brand-muted sm:grid-cols-2 lg:grid-cols-3">
            {section.fundraising.fundingTarget.breakdownItems.map((item) => <li class="border-t border-brand-border pt-3">{item}</li>)}
          </ul>
        </div>
        <p class="mt-8 border-l-2 border-brand-borderWarm pl-4 text-sm leading-7 text-brand-muted">{section.fundraising.fundingTarget.disciplineNote}</p>
      </article>

      <article class="border border-brand-border bg-brand-surface p-6 md:p-8">
        <h3 class="font-serif text-3xl leading-tight text-brand-primary">{section.fundraising.supportLevels.heading}</h3>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {section.fundraising.supportLevels.items.map((level) => (
            <div class="border-t border-brand-border pt-4">
              <p class="font-serif text-xl text-brand-primary">{level.title}</p>
              <p class="mt-1 font-mono text-sm text-brand-accent">{level.amount}</p>
              <p class="mt-3 text-sm leading-6 text-brand-muted">{level.description}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="inline-flex min-h-11 items-center border border-brand-primary bg-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-white transition hover:border-brand-primaryHover hover:bg-brand-primaryHover" href={sponsorHref}>
            {section.fundraising.supportLevels.ctas.sponsor}
          </a>
          <a class="inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent" href="#bank-transfer">
            {section.fundraising.supportLevels.ctas.bank}
          </a>
          <a class="inline-flex min-h-11 items-center border border-brand-border px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-muted transition hover:border-brand-primary hover:text-brand-primary" href="#support">
            {section.fundraising.supportLevels.ctas.listening}
          </a>
        </div>
      </article>
    </div>

    <article id="bank-transfer" class="border border-brand-border border-t-4 border-t-brand-borderWarm bg-brand-surface p-6 text-brand-text md:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <h3 class="font-serif text-3xl text-brand-primary">{section.bankHeading}</h3>
        <img
          class="h-auto w-[150px] max-w-full opacity-90 sm:w-[175px]"
          src={brandAssets.foundation.logoLight}
          width="175"
          height="30"
          alt={lang === "bg" ? "Фондация 432 Херца" : "Foundation 432 Hertz"}
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="mt-4 max-w-2xl text-base leading-8 text-brand-muted">{section.bankText}</p>
      <dl class="mt-8 grid gap-4">
        {rows.map((row) => (
          <div class="grid gap-2 border-t border-brand-border pt-4 sm:grid-cols-[180px_1fr]">
            <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-primary">{row.label}</dt>
            <dd class="break-words font-mono text-sm">{row.value}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent" href={certificateHref}>
          {lang === "bg" ? "Заявете сертификат за дарение" : "Request donation certificate"}
        </a>
        <a class="inline-flex min-h-11 items-center border border-brand-border px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-muted transition hover:border-brand-primary hover:text-brand-primary" href={policyHref}>
          {lang === "bg" ? "Политика за дарения и отчетност" : "Donation and reporting policy"}
        </a>
      </div>
    </article>

    <article class="border border-brand-border bg-brand-surface p-6">
      <h3 class="font-serif text-2xl text-brand-primary">{section.paymentPlaceholderHeading}</h3>
      <p class="mt-4 text-base leading-8 text-brand-muted">{section.paymentPlaceholder}</p>
    </article>

    <article class="border border-brand-border bg-brand-surface p-6">
      <h3 class="font-serif text-2xl text-brand-primary">{section.patronHeading}</h3>
      <p class="mt-4 text-base leading-8 text-brand-muted">{section.patronText}</p>
      <a
        class="mt-6 inline-flex min-h-11 items-center border border-brand-primary px-4 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-brand-primary transition hover:bg-brand-bg hover:text-brand-accent"
        href="mailto:info@432hz-foundation.com"
      >
        info@432hz-foundation.com
      </a>
    </article>
  </div>
</Section>
