---
import CampaignGoalBlock from "./CampaignGoalBlock.astro";
import CampaignSignupForm from "./CampaignSignupForm.astro";
import CTAButton from "./CTAButton.astro";
import type { CampaignLandingCopy, Language } from "../content/siteContent";

const { campaign, lang } = Astro.props as { campaign: CampaignLandingCopy; lang: Language };
---

<section class="relative z-0 border-b border-brand-border bg-brand-surface py-16 md:py-24">
  <div class="container grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
    <div>
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.1em] text-brand-accent">{campaign.hero.eyebrow}</p>
      <h1 class="max-w-[14ch] font-serif text-[clamp(3rem,6vw,5.5rem)] leading-[1.02] text-brand-primary">{campaign.hero.headline}</h1>
      <p class="mt-8 max-w-2xl text-xl leading-9 text-brand-muted">{campaign.hero.subheadline}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <CTAButton href="#join" label={campaign.hero.primaryCta} />
        <CTAButton href={lang === "bg" ? "/bg/#support" : "/en/#support"} label={campaign.hero.secondaryCta} variant="secondary" />
      </div>
    </div>
    <div class="border-y border-brand-border py-8">
      <div class="space-y-6 text-lg leading-9 text-brand-muted">
        {campaign.mainCopy.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>

<section class="border-b border-brand-border bg-brand-bg py-20 md:py-28">
  <div class="container grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <CampaignGoalBlock goal={campaign.goal} />
    <div id="join">
      <CampaignSignupForm form={campaign.form} lang={lang} />
    </div>
  </div>
</section>

<section class="bg-brand-primary py-20 text-white md:py-28">
  <div class="container grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
    <header>
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">{lang === "bg" ? "След записване" : "After signup"}</p>
      <h2 class="font-serif text-3xl leading-tight md:text-5xl">{campaign.afterSignup.heading}</h2>
    </header>
    <div>
      <p class="text-lg leading-9 text-white/80">{campaign.afterSignup.copy}</p>
      <div class="mt-8 border border-white/30 p-5" role="status" aria-live="polite">
        <p class="text-sm font-semibold uppercase tracking-[0.1em] text-brand-accent">{campaign.afterSignup.cta}</p>
        <p class="mt-3 text-sm leading-6 text-white/75">{campaign.afterSignup.noAudio}</p>
      </div>
    </div>
  </div>
</section>
